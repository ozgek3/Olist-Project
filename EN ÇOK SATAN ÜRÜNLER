--COPY OF ORDER_ITEMS_DATASET
CREATE OR REPLACE TABLE `elegant-hope-474619-r6.Olist.olist_order_items_dataset_cleaned` AS
SELECT * FROM  `elegant-hope-474619-r6.Olist.olist_order_items_dataset`;

--**COPY OF PRODUCTS_DATASET
CREATE OR REPLACE TABLE `elegant-hope-474619-r6.Olist.olist_products_dataset_cleaned` AS
SELECT * FROM `elegant-hope-474619-r6.Olist.olist_products_dataset`;

--FIND DUPLICATE  ORDER_IDs , PRODUCT_IDs ON ITEMS_DATASET
SELECT order_id, product_id, COUNT(*)
FROM `elegant-hope-474619-r6.Olist.olist_order_items_dataset_cleaned` 
GROUP BY order_id, product_id HAVING COUNT(*) > 1;

--DELETE DUPLICATE ORDER_IDs , PRODUCT_IDs ON ITEMS_DATASET
DELETE FROM `elegant-hope-474619-r6.Olist.olist_order_items_dataset_cleaned`
WHERE (order_id, product_id) IN (
  SELECT AS STRUCT order_id, product_id
  FROM `elegant-hope-474619-r6.Olist.olist_order_items_dataset_cleaned`
  GROUP BY order_id, product_id
  HAVING COUNT(*) > 1

--EN ÇOK SATILAN ÜRÜNLER KATEGORİ BAZINDA
--Amaç:Her ürün kategorisinde kaç satış yapılmış (kaç adet ürün satılmış) bulmak.
SELECT 
  p.product_category_name AS category,
  COUNT(oi.product_id) AS total_sold,
  ROUND(SUM(oi.price), 2) AS total_revenue
FROM `elegant-hope-474619-r6.Olist.olist_order_items_dataset_cleaned` AS oi
JOIN `elegant-hope-474619-r6.Olist.olist_products_dataset_cleaned` AS p
  ON oi.product_id = p.product_id
GROUP BY category
ORDER BY total_sold DESC
LIMIT 10;

