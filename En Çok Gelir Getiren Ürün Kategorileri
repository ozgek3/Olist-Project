--EN ÇOK GELİR GETİREN ÜRÜN KATEGORİLERİ
----Amaç: Hangi ürün kategorilerinin Olist’e en çok gelir sağladığını görmek.“en kârlı” alanları belirlemek
SELECT 
  t.product_category_name_english AS category_name,
  ROUND(SUM(oi.price), 2) AS total_revenue,
  COUNT(DISTINCT oi.product_id) AS total_products_sold
FROM `elegant-hope-474619-r6.Olist.olist_order_items_dataset_cleaned` AS oi
JOIN  `elegant-hope-474619-r6.Olist.olist_products_dataset_cleaned` AS p
  ON oi.product_id = p.product_id
JOIN `elegant-hope-474619-r6.Olist.olist_product_category_name_translation_cleaned` AS t
  ON p.product_category_name = t.product_category_name
GROUP BY category_name
ORDER BY total_revenue DESC
LIMIT 10;
